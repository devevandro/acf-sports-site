# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Only loaded when NODE_ENV=production (see src/app/layout.tsx) — dev traffic never hits GA4.
GA_MEASUREMENT_ID=
DATABASE_URL=postgres://neondb_owner:

# GA4 Data API — Service Account used to sync /midia-kit stats into the `media_kit_stats`
# table (see src/app/api/cron/media-kit/route.ts). Create the Service Account in Google Cloud,
# enable the "Google Analytics Data API", and add its email as a Viewer on the GA4 property.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
# Paste the private key from the downloaded JSON key file, keeping the \n escape sequences as-is.
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Shared secret for /api/cron/media-kit — Vercel Cron automatically sends this as
# `Authorization: Bearer $CRON_SECRET` when the env var is named exactly CRON_SECRET.
CRON_SECRET=
